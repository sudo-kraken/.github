# Example Pulumi stack file showing available repository options
# This is an example only. Use it as a template for your own stacks.

config:
  github:owner: your-github-owner
  .github:default_branch_name: main
  .github:branch_name: automation-sync
  # Prevent repository, branch, and managed-file deletion by default.
  .github:protect_repositories: true
  # Keep false unless deliberately retiring the last configured repository.
  .github:allow_empty_repositories: false
  .github:author:
    email: you@example.com
    fullname: Your Name
  .github:contact_email: you@example.com
  .github:security_email: security@example.com

  # repositories: list of repository specs to create/render
  .github:repositories:
    - name: example-python-repo
      title: Example Python Repo
      description: A small example Python project created from templates
      license: MIT
      logo: logo.svg
      topics:
        - python
        - example
      protect: true
      readme: true
      package: "example-python-repo"
      label: true
      renovatebot:
        configs:
          - python
        additional_configs: []
      language: python
      versions: ["3.11", "3.12", "3.13"]
      scaffold: true
      gitignore: true
      devcontainer: true
      docker: false
      application: true
      workflow:
        lint: true
        test: true
        changelog: true

    - name: example-docker-repo
      title: Example Docker Repo
      description: Example repo that demonstrates Docker-based deployment
      license: MIT
      logo: logo.svg
      topics:
        - docker
        - example
      readme: true
      package: "example-docker"
      label: true
      renovatebot:
        configs:
          - docker
        additional_configs: []
      language: go
      versions: ["1.23", "1.24"]
      gitignore: true
      devcontainer: true
      docker: true
      application: true
      workflow:
        lint: true
        test: true
        changelog: true

# Additional per-stack options you may find useful
# e.g. repository default visibility, organization, templates, secrets, etc.

# -----------------------------------------------------------------------------
# Options reference (for the repository spec fields shown above)
#
# repositories:               # list of repository definitions
#   - name: <string>          # repository short name (required)
#     title: <string>         # title
#     description: <string>   # short description
#     license: <string>       # license folder name under templates/license (e.g. MIT, Apache-2.0)
#     logo: <string>          # filename present in templates/logo (prefer .svg)
#     topics:                 # list of topics/tags to add
#       - topic1
#       - topic2
#     readme: <bool>          # whether to generate README.md (true/false)
#     protect: <bool>         # override the stack's deletion protection for this repository
#     package: <string|bool>  # package name, true to use repository name, or false to skip
#     package_name: <string>  # optional package-name override when package is true
#     label: <bool>           # generate repository labels (true/false)
#     renovatebot:            # renovatebot configuration (empty lists allowed)
#       configs:              # default renovate configurations to include
#         - python
#         - docker
#       additional_configs: []
#     language: <string>      # one of: python, go, rust when workflows are enabled
#     versions: [..]          # list of versions used by CI templates (e.g. python versions)
#     scaffold: <bool>        # continuously manage language project files such as pyproject.toml
#     gitignore: <bool>       # generate .gitignore (true/false)
#     devcontainer: <bool>    # include devcontainer files (true/false)
#     docker: <bool>          # enable docker workflows (true/false)
#     helm_chart_name: <str>  # defining this enables the Helm badge and usage section
#     application: <bool>     # opt-in to application-specific sections in README
#     workflow:               # per-repo workflow toggles
#       lint: <bool>          # include lint workflow
#       test: <bool>          # include test workflow
#       changelog: <bool>     # include changelog/release workflow
#     binary: <bool>          # include binary build workflow (true/false)
#     binary_platforms:       # list of dicts describing binary platforms (for matrix)
#       - os: linux
#         arch: amd64
#         runner: ubuntu-latest
#         target: x86_64-unknown-linux-gnu
#     docker_platforms:       # list of dicts describing docker build platforms
#       - os: linux
#         arch: amd64
#         runner: ubuntu-latest
#
# Notes:
# - Use boolean values (true/false) for flags. The Pulumi program validates
#   required fields and supplies documented defaults before strict rendering.
# -----------------------------------------------------------------------------
